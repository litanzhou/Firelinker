# Configuration reference only. The app does NOT automatically read .env files.
# Set process environment variables in your shell or deployment configuration.
# The browser's Model settings page can save workspace-local settings instead.
# Saved model.keys.local.json settings take precedence over these variables.
EXPERIENCE_LLM_PROVIDER=
EXPERIENCE_LLM_MODEL=
EXPERIENCE_LLM_BASE_URL=
EXPERIENCE_LLM_API_KEY=
# Required: select your own model. No model name is filled automatically.
# PROVIDER is one of openai / deepseek / compatible.
# Endpoint examples (these do not select or verify a model):
# EXPERIENCE_LLM_PROVIDER=openai
# EXPERIENCE_LLM_BASE_URL=https://api.openai.com/v1
# EXPERIENCE_LLM_PROVIDER=deepseek
# EXPERIENCE_LLM_BASE_URL=https://api.deepseek.com
# For a local/other compatible endpoint, explicitly set provider, URL and model.

# Default adapter: text Chat Completions with one structured action call.
EXPERIENCE_LLM_PROTOCOL=chat_completions
EXPERIENCE_LLM_STRUCTURED_ACTIONS=true
EXPERIENCE_LLM_INPUT_TYPES=text
EXPERIENCE_LLM_CONTEXT_CHARS=60000
EXPERIENCE_LLM_MAX_OUTPUT_TOKENS=4000
EXPERIENCE_LLM_MAX_ATTACHMENT_BYTES=26214400

# Optional native file/image route for a model and endpoint you have checked:
# EXPERIENCE_LLM_PROTOCOL=responses
# EXPERIENCE_LLM_INPUT_TYPES=text,pdf,docx,xlsx,png,jpeg,webp
# This declares expected capabilities. Test connection separately in the app.
# Current DeepSeek adapter implements text Chat Completions only; its native
# file protocol is not implemented. Local parsing remains independent of model.
